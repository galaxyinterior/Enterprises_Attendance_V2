rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isMaster() {
      return isSignedIn() && (
        (request.auth.token.keys().hasAll(['role']) && request.auth.token.role == 'MASTER') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'MASTER')
      );
    }

    function isShopAdmin(businessId) {
      return isSignedIn() && (
        isMaster() ||
        (
          (request.auth.token.keys().hasAll(['role', 'businessId']) && request.auth.token.role == 'SHOP_ADMIN' && request.auth.token.businessId == businessId) ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'SHOP_ADMIN' && getUserData().businessId == businessId)
        )
      );
    }

    function isKiosk(businessId) {
      return isSignedIn() && (
        isMaster() ||
        isShopAdmin(businessId) ||
        (
          (request.auth.token.keys().hasAll(['role', 'businessId']) && request.auth.token.role == 'KIOSK' && request.auth.token.businessId == businessId) ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'KIOSK' && getUserData().businessId == businessId)
        )
      );
    }

    // User Profile Documents
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isMaster());
      allow write: if isMaster();
    }

    // Shop Registration Requests
    match /shop_registrations/{requestId} {
      allow create: if true; // Public submission of registration form
      allow read, update, delete: if isMaster();
    }

    // System-wide Master Audit Logs
    match /master_audit_logs/{logId} {
      allow read, write: if isMaster();
    }

    // Business Tenant Hierarchy
    match /businesses/{businessId} {
      allow read: if isKiosk(businessId);
      allow create, update, delete: if isMaster();

      // Employees Sub-collection
      match /employees/{employeeId} {
        allow read: if isKiosk(businessId);
        allow write: if isShopAdmin(businessId); // Employees cannot modify themselves
      }

      // Shift Configuration Sub-collection
      match /shifts/{shiftId} {
        allow read: if isKiosk(businessId);
        allow write: if isShopAdmin(businessId);
      }

      // Attendance Records Sub-collection
      match /attendance/{attendanceId} {
        allow read: if isKiosk(businessId);
        allow create: if isKiosk(businessId); // Kiosks can log new check-ins
        allow update, delete: if isShopAdmin(businessId); // Kiosks cannot alter/rewrite existing attendance history
      }

      // Shop Calendar Holidays
      match /holidays/{holidayId} {
        allow read: if isKiosk(businessId);
        allow write: if isShopAdmin(businessId);
      }

      // Salary Advances / Udhaar
      match /advances/{advanceId} {
        allow read: if isShopAdmin(businessId);
        allow write: if isShopAdmin(businessId);
      }

      // Live Voice & Text Announcements
      match /announcements/{announcementId} {
        allow read: if isKiosk(businessId);
        allow write: if isShopAdmin(businessId);
      }

      // Kiosk Terminal Registrations
      match /devices/{deviceId} {
        allow read: if isKiosk(businessId);
        allow write: if isShopAdmin(businessId);
      }

      // Tenant Audit Logs
      match /audit_logs/{logId} {
        allow read: if isShopAdmin(businessId);
        allow create, update, delete: if isShopAdmin(businessId);
      }
    }
  }
}
